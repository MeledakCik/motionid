 app/opengraph-image.tsx | 1 +
 2 files changed, 2 insertions(+)

diff --git a/app/icon.tsx b/app/icon.tsx
index a5d122e..770f1a0 100644
--- a/app/icon.tsx
+++ b/app/icon.tsx
