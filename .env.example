# ============================================================================
# MOTIONKU - KONFIGURASI ENVIRONMENT (SIAP DEPLOY VERCEL & SUPABASE)
# ============================================================================
# Salin file ini menjadi .env.local untuk development lokal, atau masukkan
# ketiga variabel di bawah ke menu Settings -> Environment Variables di Vercel.
# Tidak ada API Key AI eksternal (0 biaya API, 0 limit kuota).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_EMAIL=kakangkasyaf@gmail.com

# ============================================================================
# MCP TRAINING (opsional, hanya untuk server lokal `npm run mcp:training`)
# ============================================================================
# Jangan isi SUPABASE_ACCESS_TOKEN di environment deployment Vercel. Token ini
# milik sesi admin dan cukup diberikan ke MCP client di komputer masing-masing.
# Untuk koneksi remote, pakai endpoint /api/mcp + header Authorization.
#
# SUPABASE_ACCESS_TOKEN=access-token-sesi-admin
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
